TRADOVATE_DEMO_USERNAME=
TRADOVATE_DEMO_PASSWORD=
TRADOVATE_DEMO_APP_ID=
TRADOVATE_DEMO_CID=
TRADOVATE_DEMO_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DB_PATH=./data/bot.db
LOG_LEVEL=INFO
TASTYTRADE_BASE_URL=https://api.cert.tastyworks.com
TASTYTRADE_CERT_USERNAME=
TASTYTRADE_CERT_PASSWORD=

# NVIDIA NIM (build.nvidia.com, free) is the primary provider for the risk and
# execution legs. Its key is NOT set here: put it in the NVIDIA_NIM_API_KEY
# environment variable or in the mode-600 file ~/.nvidia-nim-key. With neither,
# NIM is disabled and the legs run on Gemini / Cloudflare exactly as before.

# Cloudflare Workers AI — free fallback for the risk auditor (after NIM) and last
# resort for the execution judge (after Gemini). Token needs only
# Account > Workers AI > Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
